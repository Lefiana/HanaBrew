# ---------------------------------------------------------------
# HanaBrew environment. Copy to .env and adjust. NEVER commit .env.
# Validated at API startup (apps/api/src/config/env.ts); the API
# refuses to boot when a required value is missing or malformed.
# ---------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL (docker-compose bootstrap) ---
POSTGRES_USER=hanabrew
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=hanabrew

# Used by the API and by Prisma migrations when running on the host.
# Inside docker-compose the host is `postgres` instead of `localhost`.
DATABASE_URL=postgresql://hanabrew:change-me-dev-only@localhost:5432/hanabrew

# --- Tests (apps/api e2e). The database name MUST end in _test: the suite drops its schema. ---
TEST_DATABASE_URL=postgresql://hanabrew:change-me-dev-only@localhost:5432/hanabrew_test

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API with cookies.
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Swagger UI at /docs. Defaults to on outside production.
SWAGGER_ENABLED=true

# --- Authentication (Better Auth) ---
# At least 32 random characters. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Reserved for M3 (AI provider credential encryption) ---
# APP_ENCRYPTION_KEY=

# --- Web (baked into the browser bundle at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
