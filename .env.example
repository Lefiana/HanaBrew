# ---------------------------------------------------------------
# HanaBrew environment. Copy to .env and adjust. NEVER commit .env.
# Validated at API startup (apps/api/src/config/env.ts); the API
# refuses to boot when a required value is missing or malformed.
# ---------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL (docker-compose bootstrap) ---
POSTGRES_USER=hanabrew
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=hanabrew

# Used by the API and by Prisma migrations when running on the host.
# Inside docker-compose the host is `postgres` instead of `localhost`.
DATABASE_URL=postgresql://hanabrew:change-me-dev-only@localhost:5432/hanabrew

# --- Tests (apps/api e2e). The database name MUST end in _test: the suite drops its schema. ---
TEST_DATABASE_URL=postgresql://hanabrew:change-me-dev-only@localhost:5432/hanabrew_test

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API with cookies.
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Swagger UI at /docs. Defaults to on outside production.
SWAGGER_ENABLED=true

# --- Authentication (Better Auth) ---
# At least 32 random characters. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- AI (Hana) ---
# Encrypts users' personal API keys at rest (AES-256-GCM). Without it, users can't save their own
# keys in Settings (server-level keys below still work). At least 32 random characters.
# Generate: openssl rand -base64 48   (If you change it, saved keys can't be decrypted and must be re-entered.)
APP_ENCRYPTION_KEY=replace-with-another-long-random-secret-at-least-32-chars
# Optional server-wide keys, used for users who haven't saved their own. Leave blank if unused.
GEMINI_API_KEY=
GROQ_API_KEY=
# Where Ollama runs, as seen by the API process. For host development:
OLLAMA_BASE_URL=http://localhost:11434
# ...and for docker compose (the API container reaches Ollama on your machine through the host gateway):
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Let each user point Hana at their own Ollama address? Off by default: it makes the SERVER call a user-chosen URL.
AI_ALLOW_CUSTOM_OLLAMA_URL=false
# Requests per minute (per client IP) for calls that reach the model, and the per-request timeout.
AI_RATE_LIMIT_PER_MINUTE=20
AI_REQUEST_TIMEOUT_MS=90000

# --- Web (baked into the browser bundle at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
