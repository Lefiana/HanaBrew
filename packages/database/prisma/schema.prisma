// HanaBrew schema. Grown incrementally per milestone; see docs/architecture/database.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (tables required by Better Auth + its username plugin).
// Better Auth generates the UUIDs itself (advanced.database.generateId = "uuid").
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships WorkspaceMembership[]
  ownedWorkspaces Workspace[]
  settings    UserSettings?
  aiProviders AiProviderConfig[]
  aiSettings  AiSettings?
  aiConversations AiConversation[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Workspaces. Every user-owned record in later milestones hangs off a Workspace;
// access is always checked through WorkspaceMembership on the server.
// ---------------------------------------------------------------------------

enum WorkspaceKind {
  PERSONAL
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  kind      WorkspaceKind @default(PERSONAL)
  ownerId   String        @db.Uuid
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberships WorkspaceMembership[]
  tasks       Task[]
  projects    Project[]
  events      CalendarEvent[]
  aiConversations AiConversation[]
  aiActions   AiToolAction[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

// ---------------------------------------------------------------------------
// M2: productivity data. Every row belongs to a Workspace; the API scopes every
// query by workspaceId and never trusts an id from the client for ownership.
// Enum value order matters: it is the sort order (LOW < MEDIUM < HIGH < URGENT).
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model UserSettings {
  userId    String   @id @db.Uuid
  /// IANA zone used to render times (e.g. "Asia/Manila").
  timeZone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  /// Calendar dates (no time, no zone).
  startDate   DateTime?     @db.Date
  targetDate  DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId, status])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  projectId   String?      @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  /// Calendar date (no time, no zone) so it never shifts with time zones.
  dueDate     DateTime?    @db.Date
  completedAt DateTime?    @db.Timestamptz(3)
  tags        String[]     @default([])
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, projectId])
  @@map("tasks")
}

/// Timed events: startsAt/endsAt are exact instants.
/// All-day events: floating dates stored as UTC midnight; endsAt is the EXCLUSIVE end (next day 00:00Z).
model CalendarEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  title       String
  description String?
  category    String?
  allDay      Boolean  @default(false)
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  /// IANA zone the event was created in (display fidelity; basis for future recurrence).
  timeZone    String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@map("calendar_events")
}

// ---------------------------------------------------------------------------
// M3: AI assistant. Credentials are per user and stored encrypted (AES-256-GCM); conversations belong
// to a user inside a workspace; every tool call is recorded in AiToolAction (the audit log).
// ---------------------------------------------------------------------------

enum AiProvider {
  GEMINI
  GROQ
  OLLAMA
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum AiToolRisk {
  READ
  WRITE
  DESTRUCTIVE
}

enum AiActionStatus {
  PENDING
  RUNNING
  EXECUTED
  REJECTED
  FAILED
  EXPIRED
}

enum AiConfirmationPolicy {
  DESTRUCTIVE_ONLY
  ALL_WRITES
}

model AiProviderConfig {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  provider        AiProvider
  /// "v1.<iv>.<tag>.<ciphertext>" (AES-256-GCM, bound to this user + provider). Never returned by the API.
  apiKeyEncrypted String?
  /// Last 4 characters of the key, so the user can recognise which key is stored.
  apiKeyHint      String?
  model           String?
  /// Ollama endpoint override (only honoured when the server allows custom endpoints).
  baseUrl         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("ai_provider_configs")
}

model AiSettings {
  userId             String               @id @db.Uuid
  preferredProvider  AiProvider?
  fallbackProvider   AiProvider?
  /// Falling back to a CLOUD provider sends the conversation to a third party, so it is opt-in.
  allowCloudFallback Boolean              @default(false)
  confirmationPolicy AiConfirmationPolicy @default(DESTRUCTIVE_ONLY)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model AiConversation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  title       String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  actions   AiToolAction[]

  @@index([workspaceId, userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  seq            Int
  role           AiMessageRole
  content        String        @default("")
  /// Assistant turns: the tool calls requested ([{ id, name, args, argsError? }]).
  toolCalls      Json?
  /// Opaque provider data that must be replayed verbatim (e.g. Gemini thought signatures).
  providerState  Json?
  /// Tool turns: which call this answers.
  toolCallId     String?
  toolName       String?
  provider       AiProvider?
  model          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@map("ai_messages")
}

/// One row per tool call: proposed, approved/rejected, executed or failed. This is the audit log. When a
/// conversation is deleted the row survives with its content (args, summary, result) wiped.
model AiToolAction {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @db.Uuid
  userId         String         @db.Uuid
  conversationId String?        @db.Uuid
  toolCallId     String
  toolName       String
  risk           AiToolRisk
  status         AiActionStatus
  args           Json
  summary        String
  result         Json?
  provider       AiProvider?
  model          String?
  targetId       String?
  expiresAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?      @db.Timestamptz(3)

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([workspaceId, userId, createdAt])
  @@map("ai_tool_actions")
}
